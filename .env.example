# Environment Configuration for Intelligent Healthcare & Health Insurance Decision Platform

# Application Settings
APP_NAME="Intelligent Healthcare & Health Insurance Decision Platform"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security & Authentication
# In production, replace with a secure random secret key (e.g. openssl rand -hex 32)
SECRET_KEY=dev-healthcare-decision-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite file in backend/
DATABASE_URL=sqlite:///./healthcare_platform.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ML Artifact Paths (relative to backend or absolute)
MODELS_DIR=../models
DATA_DIR=../data

# Decision Engine Configurable Weights (Must sum to 1.0)
WEIGHT_AFFORDABILITY=0.35
WEIGHT_COVERAGE=0.30
WEIGHT_RISK_MATCH=0.20
WEIGHT_TERMS_FIT=0.15
